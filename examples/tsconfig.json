{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"skipLibCheck": true,
		"noEmit": true,
		"paths": {
			"liquid-glass": ["../src/index.ts"],
			"liquid-glass/react": ["../src/react.ts"]
		}
	},
	"include": ["src"]
}
